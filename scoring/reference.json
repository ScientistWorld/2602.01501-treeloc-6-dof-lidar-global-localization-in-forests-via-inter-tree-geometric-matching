{
  "experiments": {
    "synthetic_forest_localization": {
      "description": "Scaled tree-inventory reproduction of TreeLoc's core forest place-recognition and localization claim; reference values are TreeLoc and BTC results from the paper's Oxford Stein 3-DoF localization setting where metrics overlap.",
      "weight": 1.0,
      "primary_metric": "R_at_50",
      "metrics": {
        "R_at_1": {"higher_is_better": true, "coefficient": 0.6},
        "F1": {"higher_is_better": true, "coefficient": 0.4},
        "AUC": {"higher_is_better": true, "coefficient": 0.4},
        "R_at_50": {"higher_is_better": true, "coefficient": 1.0},
        "SR": {"higher_is_better": true, "coefficient": 0.6},
        "TE_m": {"higher_is_better": false, "coefficient": -0.5},
        "RE_deg": {"higher_is_better": false, "coefficient": -0.3}
      },
      "results": {
        "btc": {
          "type": "baseline",
          "R_at_1": 0.611,
          "F1": 0.774,
          "AUC": 0.803,
          "R_at_50": 0.638,
          "SR": 0.780,
          "TE_m": 0.225,
          "RE_deg": 0.641
        },
        "treeloc": {
          "type": "proposed",
          "R_at_1": 0.871,
          "F1": 0.945,
          "AUC": 0.988,
          "R_at_50": 0.970,
          "SR": 0.987,
          "TE_m": 0.053,
          "RE_deg": 0.137
        }
      }
    }
  }
}
